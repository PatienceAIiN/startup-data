DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/startupintel?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx.neon.tech/startupintel?sslmode=require
SECRET_KEY=your-256-bit-secret-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=startupintel-exports
R2_ENDPOINT_URL=https://{ACCOUNT_ID}.r2.cloudflarestorage.com
APP_ENV=production
FRONTEND_URL=https://startupintel-frontend.onrender.com
BACKEND_URL=https://startupintel-backend.onrender.com
CORS_ORIGINS=["https://startupintel-frontend.onrender.com"]
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SCRAPER=5/hour
ZAUBA_BASE_URL=https://www.zaubacorp.com/company-list
DATAGOV_API_URL=https://api.data.gov.in/resource/
DATAGOV_API_KEY=your_datagov_api_key
SCRAPE_MAX_PAGES=50
SCRAPE_CONCURRENT_LIMIT=3
MATCH_CONFIDENCE_THRESHOLD=0.75
